# AI — Vercel AI Gateway. Without this key, the app runs in demo mode.
AI_GATEWAY_API_KEY=
AI2DOT_ENABLE_AI_GATEWAY=false

# Semantic knowledge retrieval. By default embeddings use Vercel AI Gateway.
# To reuse an encrypted provider configured in /admin, set its exact name here.
# Otherwise set BASE_URL and API_KEY for a dedicated OpenAI-compatible endpoint.
# The endpoint must support a 1536-dimension output. Keep the model stable.
AI2DOT_EMBEDDING_PROVIDER_NAME=
AI2DOT_EMBEDDING_MODEL=openai/text-embedding-3-small
AI2DOT_EMBEDDING_BASE_URL=
AI2DOT_EMBEDDING_API_KEY=

# Authentication — Clerk. Both values are required to enable sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Authentication — local single-admin mode for self-hosted deployments.
# Generate a hash with: node scripts/hash-password.mjs 'your-strong-password'
AI2DOT_AUTH_MODE=local
AI2DOT_LOCAL_AUTH_EMAIL=admin@ai2dot.local
AI2DOT_LOCAL_AUTH_PASSWORD_HASH=
AI2DOT_SESSION_SECRET=
AI2DOT_SESSION_TTL_HOURS=168
# Set true only when the public site is served over HTTPS.
AI2DOT_COOKIE_SECURE=false

# Persistence — Docker Compose provides PostgreSQL by default.
POSTGRES_DB=ai2dot
POSTGRES_USER=ai2dot
POSTGRES_PASSWORD=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_POOL_MAX=10
POSTGRES_SHM_SIZE=256mb
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB

# Per-user chat protection. Defaults to 30 and is clamped to 1-300.
AI2DOT_CHAT_RATE_LIMIT_PER_MINUTE=30

# Planned infrastructure for private uploads.
BLOB_READ_WRITE_TOKEN=

# 32-byte base64 key for encrypting provider credentials at rest.
# Generate with: openssl rand -base64 32
PROVIDER_SECRET_ENCRYPTION_KEY=
# Stable HMAC secret for signing MCP approval requests in Docker and Vercel.
# Generate with: openssl rand -base64 32
AI2DOT_TOOL_APPROVAL_SECRET=
CRON_SECRET=

# Chrome extension. Comma-separated production/development extension IDs.
# The bundled development manifest key resolves to this ID.
AI2DOT_CHROME_EXTENSION_IDS=pmnodojbgoalhleimdnafblgnnffcgmm

# Notebook Studio is native and always remains usable with PostgreSQL.
# Gemini Notebook Enterprise is an optional external provider.
AI2DOT_ENABLE_NOTEBOOK_STUDIO=true
AI2DOT_ENABLE_GOOGLE_NOTEBOOK_PROVIDER=false
# Use cn-mainland for a Docker host physically deployed in mainland China.
AI2DOT_DEPLOYMENT_REGION=cn-mainland
GOOGLE_NOTEBOOK_PROJECT_NUMBER=
# Google currently documents global/us/eu and selected allowlisted in-country locations.
GOOGLE_NOTEBOOK_LOCATION=global
GOOGLE_NOTEBOOK_CLIENT_ID=
GOOGLE_NOTEBOOK_CLIENT_SECRET=
# Development probe only. Do not use a manually copied token as a long-lived credential.
GOOGLE_NOTEBOOK_ACCESS_TOKEN=

# Docker deployment tuning.
AI2DOT_PORT=3000
AI2DOT_IMAGE_TAG=latest
AI2DOT_NODE_MEMORY_MB=768
AI2DOT_KEEP_ALIVE_TIMEOUT_MS=65000
