# AI — Vercel AI Gateway. Without this key, the app runs in demo mode.
AI_GATEWAY_API_KEY=

# Authentication — Clerk. Both values are required to enable sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Persistence — Neon PostgreSQL. When Clerk + Neon are configured, conversations
# become account-scoped and survive across devices. Otherwise local demo history is used.
DATABASE_URL=

# Per-user chat protection. Defaults to 30 and is clamped to 1-300.
AI2DOT_CHAT_RATE_LIMIT_PER_MINUTE=30

# Planned infrastructure for private uploads.
BLOB_READ_WRITE_TOKEN=

# 32-byte base64 key for encrypting provider credentials at rest.
# Generate with: openssl rand -base64 32
PROVIDER_SECRET_ENCRYPTION_KEY=
CRON_SECRET=
